# Chan Quant defaults to remote market access for its local research experience.
CHAN_QUANT_DATA_SOURCE=sina
CHAN_QUANT_SINA_DATALEN=2000
CHAN_QUANT_REMOTE_NETWORK_ENABLED=true

# Set this to false together with CHAN_QUANT_DATA_SOURCE=synthetic for a
# deterministic offline dashboard. Remote-only API routes then fail closed.
# CHAN_QUANT_DATA_SOURCE=synthetic
# CHAN_QUANT_REMOTE_NETWORK_ENABLED=false
