# Copy values into a private runtime env file outside Git. The application does
# not load this file automatically.
CHAN_QUANT_ENVIRONMENT=production
CHAN_QUANT_DATA_SOURCE=synthetic
CHAN_QUANT_REMOTE_NETWORK_ENABLED=false
CHAN_QUANT_ALLOW_FORCE_REFRESH=false
CHAN_QUANT_DOCS_ENABLED=false
CHAN_QUANT_ALLOWED_HOSTS=localhost,127.0.0.1
CHAN_QUANT_RELEASE_SHA=replace-with-git-sha

# Replace both placeholders before starting Compose. Generate the hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'private-password'
CHAN_QUANT_BASIC_AUTH_USER=replace-with-private-username
CHAN_QUANT_BASIC_AUTH_HASH=replace-with-caddy-hash

# Optional host settings. External CSV/snapshot inputs remain outside Git and
# are mounted read-only at /market-data inside the API container.
CHAN_QUANT_WEB_PORT=8080
CHAN_QUANT_DATA_MOUNT=./data
